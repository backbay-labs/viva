{
  "name": "viva",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@viva/web",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:agent:signed": "VIVA_DEV_AGENT_SIGNED_SESSION=1 node scripts/dev-agent.mjs",
    "dev:web": "bun run --cwd apps/web dev",
    "agent:fmt": "cargo fmt --manifest-path agent/Cargo.toml --all -- --check",
    "agent:clippy": "cargo clippy --manifest-path agent/Cargo.toml --workspace --all-targets -- -D warnings",
    "agent:test": "VIVA_ALLOW_LOOPBACK_TEST_SKIP=1 cargo test --manifest-path agent/Cargo.toml --workspace",
    "agent:replay:ws": "cargo test --manifest-path agent/Cargo.toml -p agent-service --test voice_ws real_websocket_replays -- --nocapture",
    "agent:build": "cargo build --manifest-path agent/Cargo.toml --workspace",
    "agent:purity": "scripts/check-agent-domain-purity.sh",
    "redaction:check": "node scripts/redaction-control-check.mjs",
    "release:hygiene": "sh scripts/check-generated-artifact-hygiene.sh",
    "release:check": "node scripts/release-check.mjs",
    "hosted:monitor": "node scripts/hosted-monitor-runner.mjs",
    "live:smoke": "node scripts/live-provider-smoke.mjs",
    "e2e:browser": "node scripts/e2e-browser.mjs",
    "e2e:browser:audio": "node scripts/e2e-browser-audio.mjs",
    "e2e:browser:audio:negative": "node scripts/e2e-browser-audio.mjs --case oversized-single-chunk",
    "build": "turbo run build",
    "build:cache:prove": "node scripts/prove-turbo-cache-restoration.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "bun run test:scripts && turbo run test",
    "validate:ts": "bun run typecheck && bun run lint && bun run test && bun run build",
    "validate:agent": "bun run agent:fmt && bun run agent:clippy && bun run agent:test && bun run agent:build && bun run agent:purity",
    "validate": "bun run validate:ts && bun run validate:agent && bun run release:hygiene",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@viva/core": "workspace:*",
    "playwright": "^1.51.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "ws": "^8.21.0",
    "yaml": "2.8.2"
  }
}
