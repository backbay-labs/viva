VIVA_ENV=local
VIVA_AGENT_BASE_URL=http://127.0.0.1:4318
VIVA_VOICE_TRUSTED_USER_ID=user-1
VIVA_VOICE_TRUSTED_STUDY_SET_ID=biology-midterm
VIVA_VOICE_TRUSTED_SESSION_ID=voice-session-1
NEXT_PUBLIC_VIVA_AGENT_WS_URL=ws://127.0.0.1:4318/ws
NEXT_PUBLIC_VIVA_VOICE_TRUSTED_USER_ID=user-1
NEXT_PUBLIC_VIVA_VOICE_TRUSTED_SESSION_ID=voice-session-1
NEXT_PUBLIC_VIVA_API_URL=http://127.0.0.1:4318
# Local loopback dev leaves signed session-token auth unset. `bun run dev:agent`
# also clears any inherited value so a production-like root `.env` cannot force
# signed /session tokens on the no-key synthetic path.
# VIVA_VOICE_SESSION_TOKEN_SECRET=
