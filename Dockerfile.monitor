# RELEASE-026: immutable, digest-pinned base image -- see
# docs/deployment-runbook.md#container-supply-chain-release-026.
FROM mcr.microsoft.com/playwright:v1.61.0-noble@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a

WORKDIR /app

# RELEASE-026: install Bun 1.3.3 from verified release bytes instead of
# piping a remote install script into a shell. Download, checksum, extract,
# install, and clean up the temporary archive/extraction directory all
# happen in this one RUN instruction so the cleanup actually reclaims this
# layer's own space.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip \
  && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
RUN set -eu; \
  case "$TARGETARCH" in \
    amd64) bun_archive="bun-linux-x64.zip"; bun_sha256="f5c546736f955141459de231167b6fdf7b01418e8be3609f2cde9dfe46a93a3d" ;; \
    arm64) bun_archive="bun-linux-aarch64.zip"; bun_sha256="41b9f4f25256db897c2c135320e4f96c373e20ae6f06d8015187dac83591efc8" ;; \
    *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  tmp="$(mktemp -d)"; \
  curl -fsSL -o "$tmp/$bun_archive" "https://github.com/oven-sh/bun/releases/download/bun-v1.3.3/$bun_archive"; \
  echo "$bun_sha256  $tmp/$bun_archive" | sha256sum -c -; \
  unzip -q "$tmp/$bun_archive" -d "$tmp"; \
  install -m 0755 "$tmp"/bun-linux-*/bun /usr/local/bin/bun; \
  rm -rf "$tmp"

COPY --chown=pwuser:pwuser package.json bun.lock turbo.json tsconfig.base.json biome.json ./
COPY --chown=pwuser:pwuser apps ./apps
COPY --chown=pwuser:pwuser packages ./packages
COPY --chown=pwuser:pwuser scripts ./scripts
COPY --chown=pwuser:pwuser docs ./docs
COPY --chown=pwuser:pwuser agent/fixtures ./agent/fixtures

RUN bun install --frozen-lockfile
RUN apt-get update \
  && apt-get install -y --no-install-recommends espeak-ng ffmpeg \
  && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /app/evidence \
  && espeak-ng -v en-us -s 145 -w /tmp/live-smoke-answer.wav "The proton gradient drives ATP synthase to make ATP." \
  && ffmpeg -hide_banner -loglevel error -y -i /tmp/live-smoke-answer.wav -ac 1 -ar 24000 -f s16le /app/evidence/live-smoke-answer.pcm \
  && rm -f /tmp/live-smoke-answer.wav \
  && chown -R pwuser:pwuser /app/evidence

# RELEASE-026: drop root for the actual monitor run; only the build-time
# apt/Bun/espeak-ng/ffmpeg work above needs it.
USER pwuser

CMD ["bun", "run", "hosted:monitor"]
