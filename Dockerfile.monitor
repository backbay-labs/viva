FROM mcr.microsoft.com/playwright:v1.61.0-noble

WORKDIR /app

RUN curl -fsSL https://bun.sh/install | bash -s -- bun-v1.3.3
ENV PATH="/root/.bun/bin:${PATH}"

COPY package.json bun.lock turbo.json tsconfig.base.json biome.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY docs ./docs
COPY agent/fixtures ./agent/fixtures

RUN bun install --frozen-lockfile
RUN apt-get update \
  && apt-get install -y --no-install-recommends espeak-ng ffmpeg \
  && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /app/evidence \
  && espeak-ng -v en-us -s 145 -w /tmp/live-smoke-answer.wav "The proton gradient drives ATP synthase to make ATP." \
  && ffmpeg -hide_banner -loglevel error -y -i /tmp/live-smoke-answer.wav -ac 1 -ar 24000 -f s16le /app/evidence/live-smoke-answer.pcm \
  && rm -f /tmp/live-smoke-answer.wav

CMD ["bun", "run", "hosted:monitor"]
