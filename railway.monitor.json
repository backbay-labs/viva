{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.monitor",
    "watchPatterns": [
      "Dockerfile.monitor",
      "agent/fixtures/**",
      "apps/web/**",
      "bun.lock",
      "docs/deployment-runbook.md",
      "package.json",
      "packages/**",
      "railway.monitor.json",
      "scripts/**"
    ]
  },
  "deploy": {
    "cronSchedule": "*/30 * * * *",
    "restartPolicyType": "NEVER",
    "startCommand": "bun run hosted:monitor"
  }
}
