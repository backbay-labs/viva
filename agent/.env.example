# Optional: uncomment to use Postgres instead of the default in-memory fixture store.
# DATABASE_URL=postgres://localhost/viva_agent
VIVA_AGENT_BIND_ADDR=127.0.0.1:4318
VIVA_AGENT_PROVIDER=synthetic
VIVA_VOICE_TRUSTED_USER_ID=user-1
VIVA_VOICE_TRUSTED_STUDY_SET_ID=biology-midterm
VIVA_VOICE_TRUSTED_SESSION_ID=voice-session-1
VIVA_VOICE_WS_BEARER_TOKEN=
# Leave empty for loopback local /session bootstrap. Set only for the signed
# production path, or run `bun run dev:agent:signed` from the repo root when
# deliberately testing signed session-token auth locally.
VIVA_VOICE_SESSION_TOKEN_SECRET=
VIVA_VOICE_WS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VIVA_VOICE_WS_MAX_SESSIONS=16
# Live provider settings. Leave the runtime gate disabled outside an explicit
# live smoke or production-like provider proof.
# VIVA_CARTESIA_GEMINI_LIVE_RUNTIME=0
# CARTESIA_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_BASE_URL=
# GEMINI_THINKING_LEVEL=LOW
# CARTESIA_INK_MODEL=
# CARTESIA_SONIC_MODEL=
# CARTESIA_VOICE_ID=
# Set these only after provider-side zero-data-retention controls are confirmed.
# CARTESIA_ZERO_DATA_RETENTION_ENABLED=0
# GEMINI_ZERO_DATA_RETENTION_APPROVED=0
RUST_LOG=agent_service=info,tower_http=info
