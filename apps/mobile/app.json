{
  "expo": {
    "name": "Viva",
    "slug": "viva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viva",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.backbay.viva",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.backbay.viva"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F0E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-audio-api",
        {
          "androidForegroundService": false,
          "androidFSTypes": [],
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "Viva uses the microphone only after you tap Start listening to verify local capture readiness. Protocol v4 does not send this audio."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "autolinkingModuleResolution": true,
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
